# ==========================================================
# Dance School Management System - Environment Variables
# ==========================================================

# 1. Supabase PostgreSQL Configuration (Free at https://supabase.com)
# Once you create a Supabase project, go to Settings -> API to copy these:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. Razorpay Payment Gateway (Test/Live Keys from https://dashboard.razorpay.com)
# Default is mock mode for local testing without real money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# 3. Security (JWT Secret)
JWT_SECRET=dance_school_super_secure_jwt_secret_key_2026
